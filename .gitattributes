* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
# LFS applies to newly processed/imported binaries without migrating ASSET history.
ArtSource/Processed/**/*.fbx filter=lfs diff=lfs merge=lfs -text
ArtSource/Processed/**/*.glb filter=lfs diff=lfs merge=lfs -text
ArtSource/Processed/**/*.blend filter=lfs diff=lfs merge=lfs -text
Assets/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
Assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
Assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
Assets/**/*.tga filter=lfs diff=lfs merge=lfs -text
Assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
